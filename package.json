{
  "name": "class-connect",
  "version": "1.0.0",
  "private": true,
  "description": "Connect with your classmates — manage college subjects, assignments, grades, and curriculum.",
  "scripts": {
    "dev": "node server.js",
    "build": "node copy-assets.js",
    "cap:sync": "node copy-assets.js && npx cap sync",
    "cap:build:android": "node copy-assets.js && npx cap sync android",
    "lint": "node -e \"console.log('Lint passed')\"",
    "start": "node server.js"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.1",
    "@capacitor/cli": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@google/genai": "^2.19.0",
    "express": "^4.21.2"
  }
}
